# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Rollback stashes written by deploy/update.sh
/.next.previous-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# plant server data (seeded on first run)
/data
/agent-tools

# Android build
/android/.gradle/
/android/build/
/android/app/build/
# Build output. The authoritative APK is the frozen one in android/shipped/;
# this directory is whatever the last local build happened to produce.
/android/dist/
/android/local.properties
/android/.idea/
*.iml

# Android signing material — NEVER commit these.
# The release keystore is what lets an updated APK install over an already
# installed one. If it leaks, anyone can sign an app that phones accept as
# this one; if it is lost, no update can ever be installed again.
*.jks
*.keystore
/android/keystore.properties
