# ── OCL Maintenance server configuration ─────────────────────────────────────
# Copy to ".env" in the repository root, then fill it in:
#
#   cp deploy/.env.example .env
#
# On this server nginx handles HTTPS, so there is no domain or email to set here
# (that lives in the nginx site file). Only the signing secret is required.

# Secret used to sign login tokens. MUST be at least 32 characters.
# Generate one with:   openssl rand -hex 32
# Never share it, and never commit the .env file.
JWT_SECRET=

# How long a phone stays signed in before it must log in again.
TOKEN_TTL=30d

# The first administrator account, created automatically on first start.
# If ADMIN_PASSWORD is left empty, a random one is generated and printed ONCE
# in the container log — read it with:  docker compose logs api
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
