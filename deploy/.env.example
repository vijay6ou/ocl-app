# ── OCL Maintenance server configuration ─────────────────────────────────────
# Copy this file to ".env" in the repository root, then fill in the values:
#
#   cp deploy/.env.example .env
#   nano .env

# Your DuckDNS address, WITHOUT https:// and without a trailing slash.
# Example: ocl-plant.duckdns.org
DOMAIN=

# An email address for Let's Encrypt expiry notices. Any address you can read.
ACME_EMAIL=

# Secret used to sign login tokens. MUST be at least 32 characters.
# Generate one with:   openssl rand -hex 32
# Never share it, and never commit the .env file.
JWT_SECRET=

# How long a phone stays signed in before it must log in again.
TOKEN_TTL=30d

# The first administrator account, created automatically on first start.
# If you leave ADMIN_PASSWORD empty, a random password is generated and printed
# once in the container log — look for it with:  docker compose logs api
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
